# direnv: one uv workspace environment for this repository.
#
# `uv sync` runs only when the environment is missing or the lock is newer, so
# entering the directory is cheap once the environment exists.
watch_file pyproject.toml uv.lock
if command -v uv >/dev/null 2>&1; then
  if [ ! -d .venv ] || [ uv.lock -nt .venv ]; then
    uv sync --all-packages --quiet
  fi
  source .venv/bin/activate
else
  echo "direnv: uv is not installed; the environment was not loaded" >&2
fi
